# Copy to .env and fill in values for your environment.
# Never commit real credentials. Use distinct, randomly generated JWT secrets.
DB_DSN=
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
JWT_SECRET_KEY=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=
# Other EMAIL_PROVIDER values: smtp (SMTP_*), aliyun_dm (ALIYUN_DM_*), tencent_ses (TENCENT_SES_*);
# see biz/mw/email/email.go for the variable list.
# AES-256 key (base64, 32 bytes) for per-organization email provider configs.
# Generate with: openssl rand -base64 32
EMAIL_CONFIG_KEY=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_PUBLIC_BASE_URL=
JWT_SECRET_KEY_ADMIN=
JWT_SECRET_KEY_USER=
INTERNAL_API_TOKEN=

# Logging. LOG_LEVEL: debug/info/warn/error. LOG_OUTPUT: file, stdout or both
# (use stdout when a collector ships container logs). LOG_FILE only applies
# when the output includes file.
LOG_LEVEL=info
LOG_OUTPUT=file
LOG_FILE=hlog/logs/app.log

# Local data only; blank paths disable that source. Restart after replacing files.
IP2REGION_DB_PATH=
GEOLITE2_CITY_DB_PATH=
# Example: 10.20.0.0/24,2001:db8:1234::/48. Empty = socket peer only.
LOGIN_TRUSTED_PROXY_CIDRS=

# AES-256-GCM key, base64 of 32 random bytes. Empty disables MFA enrollment;
# accounts with MFA enabled fail closed when this key is unavailable.
ADMIN_MFA_ENCRYPTION_KEY=
# At least 32 random characters, supplied as Authorization: Bearer by scrapers.
SECURITY_METRICS_TOKEN=
# Destructive retention is opt-in and defaults to dry-run.
SECURITY_RETENTION_ENABLED=false
SECURITY_RETENTION_DRY_RUN=true
SECURITY_RETENTION_DAYS=180
